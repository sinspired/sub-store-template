{
  "log": {
    "level": "error"
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "detour": "DIRECT"
  },
  "dns": {
    "servers": [
      {
        "tag": "aliyun",
        "type": "https",
        "detour": "DIRECT",
        "server": "223.5.5.5"
      },
      {
        "tag": "unicom",
        "type": "udp",
        "detour": "DIRECT",
        "server": "202.106.46.151"
      },
      {
        "tag": "cloudflare",
        "type": "https",
        "detour": "PROXY",
        "server": "1.1.1.1"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      },
      {
        "tag": "tailscale",
        "type": "tailscale",
        "endpoint": "ts-ep",
        "accept_search_domain": true
      }
    ],
    "rules": [
      {
        "preferred_by": "tailscale",
        "action": "route",
        "server": "tailscale",
        "disable_optimistic_cache": true
      },
      {
        "query_type": "PTR",
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "domain_suffix": ".arpa",
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "domain_suffix": [
          ".local",
          ".lan"
        ],
        "action": "predefined"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB",
          "AAAA"
        ],
        "action": "predefined"
      },
      {
        "rule_set": "fakeip-filter",
        "action": "route",
        "server": "aliyun"
      },
      {
        "rule_set": "geosite-apple",
        "action": "route",
        "server": "aliyun"
      },
      {
        "domain_suffix": "telegram.org",
        "action": "route",
        "server": "cloudflare"
      },
      {
        "query_type": "A",
        "rule_set": "geosite-geolocation-!cn",
        "invert": true,
        "timeout": "300ms",
        "action": "evaluate",
        "server": "unicom",
        "tag": "cn-isp",
        "speculative": true
      },
      {
        "query_type": "A",
        "rule_set": "geosite-geolocation-!cn",
        "invert": true,
        "timeout": "300ms",
        "action": "evaluate",
        "server": "aliyun",
        "tag": "cn-doh",
        "speculative": true
      },
      {
        "query_type": "A",
        "match_response": "cn-isp",
        "response_rcode": "NOERROR",
        "rule_set": "geoip-cn",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "query_type": "A",
        "match_response": "cn-doh",
        "response_rcode": "NOERROR",
        "rule_set": "geoip-cn",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-geolocation-cn"
        ],
        "match_response": "cn-isp",
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-geolocation-cn"
        ],
        "match_response": "cn-doh",
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "query_type": "A",
        "action": "route",
        "server": "fakeip"
      }
    ],
    "final": "cloudflare",
    "cache_capacity": 1024,
    "optimistic": {
      "enabled": true,
      "timeout": "10m"
    },
    "timeout": "2s"
  },
  "http_clients": [
    {
      "tag": "rule-download",
      "detour": "PROXY"
    }
  ],
  "endpoints": [
    {
      "tag": "ts-ep",
      "type": "tailscale",
      "detour": "DIRECT",
      "state_directory": "ts-state",
      "hostname": "iPhone",
      "accept_routes": true
    }
  ],
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30"
      ],
      "dns_mode": "hijack",
      "auto_route": true,
      "udp_timeout": "10s",
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "tag": "PROXY",
      "type": "selector",
      "outbounds": [
        "DIRECT"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "GLOBAL",
      "type": "selector",
      "outbounds": [
        "DIRECT"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "YOUTUBE",
      "type": "selector",
      "outbounds": [
        "DIRECT"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "EMBY",
      "type": "selector",
      "outbounds": [
        "DIRECT"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "SPEEDTEST",
      "type": "selector",
      "outbounds": [
        "DIRECT"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "DIRECT",
      "type": "direct",
      "domain_resolver": "aliyun"
    }
  ],
  "route": {
    "rules": [
      {
        "network": "udp",
        "port": 443,
        "rule_set": [
          "geosite-cn",
          "geosite-geolocation-cn",
          "geoip-cn"
        ],
        "action": "reject"
      },
      {
        "network": "icmp",
        "action": "reject",
        "method": "drop"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "preferred_by": "ts-ep",
        "action": "route",
        "outbound": "ts-ep"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "polluted-ip",
        "action": "reject"
      },
      {
        "action": "sniff",
        "sniffer": [
          "tls",
          "quic",
          "http",
          "dns"
        ]
      },
      {
        "rule_set": "doh-block",
        "port": 443,
        "action": "reject"
      },
      {
        "rule_set": "httpdns-block",
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "speedtest-international",
        "action": "route",
        "outbound": "SPEEDTEST"
      },
      {
        "domain": "token.safebrowsing.apple",
        "action": "reject"
      },
      {
        "rule_set": "geosite-apple",
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "geosite-google-gemini",
        "action": "route",
        "outbound": "PROXY"
      },
      {
        "rule_set": "geosite-category-ai-!cn",
        "action": "route",
        "outbound": "PROXY"
      },
      {
        "rule_set": "emby",
        "action": "route",
        "outbound": "EMBY"
      },
      {
        "rule_set": "geosite-youtube",
        "action": "route",
        "outbound": "YOUTUBE"
      },
      {
        "rule_set": "telegram-dc5",
        "action": "route",
        "outbound": "PROXY"
      },
      {
        "rule_set": "telegram-dc13",
        "action": "route",
        "outbound": "PROXY"
      },
      {
        "rule_set": "telegram-dc24",
        "action": "route",
        "outbound": "PROXY"
      },
      {
        "rule_set": "geosite-google",
        "action": "route",
        "outbound": "PROXY"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "action": "route",
        "outbound": "PROXY"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-geolocation-cn",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "DIRECT"
      }
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs",
        "format": "binary"
      },
      {
        "tag": [
          "geosite-cn",
          "geosite-apple",
          "geosite-google",
          "geosite-google-gemini",
          "geosite-youtube",
          "geosite-geolocation-cn",
          "geosite-category-ai-!cn",
          "geosite-geolocation-!cn"
        ],
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
        "format": "binary"
      },
      {
        "tag": [
          "emby",
          "doh-block",
          "polluted-ip",
          "telegram-dc5",
          "telegram-dc13",
          "telegram-dc24",
          "fakeip-filter",
          "httpdns-block",
          "speedtest-international"
        ],
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/fa1nes/sing-box-rules@main/srs/{tag}.srs",
        "format": "binary"
      }
    ],
    "final": "PROXY",
    "auto_detect_interface": true,
    "default_network_strategy": "fallback",
    "default_network_type": [
      "wifi"
    ],
    "default_fallback_network_type": [
      "cellular"
    ],
    "default_domain_resolver": "aliyun",
    "default_http_client": "rule-download"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    }
  }
}